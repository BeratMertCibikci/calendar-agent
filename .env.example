# Copy to .env and edit. The real .env is git-ignored.

# --- Engine: which LLM drives the agent ---------------------------------
#   gemini : Google Gemini API (cloud, needs GEMINI_API_KEY)
#   ollama : local model through Ollama (no key, runs on your machine)
#   demo   : keyword rules, no LLM at all (try the UI and tools offline)
ENGINE=gemini
GEMINI_API_KEY=
# Models are tried in order; the next one is used when a model is overloaded or retired.
GEMINI_MODELS=gemini-2.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
OLLAMA_MODEL=qwen2.5:14b

# --- Calendar backend ----------------------------------------------------
#   google : your real Google Calendar (see README, "Google Calendar setup")
#   memory : throwaway in-memory calendar, handy for demos and tests
CALENDAR_BACKEND=google

# --- Mail (optional) -----------------------------------------------------
#   none   : mail tools disabled (default)
#   gmail  : read your mail and create drafts (enable the Gmail API, then run `calendar-agent auth` again)
#   memory : demo mailbox with sample messages
# The agent can never send mail. With ENGINE=gemini, mails it reads are sent to Google's API.
MAIL_BACKEND=none

# --- Personalisation -----------------------------------------------------
TIMEZONE=Europe/Paris
# tr | en | fr  (language of the assistant and of the UI)
ASSISTANT_LANGUAGE=en
# Optional free text added to the system prompt, e.g. "The user is a master's student in Paris."
USER_CONTEXT=

# --- Server --------------------------------------------------------------
HOST=127.0.0.1
PORT=5001
# Where the SQLite database, credentials.json and token.json live
DATA_DIR=data
